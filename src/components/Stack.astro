---
interface Props {
  /** The technologies a Project or Experience entry was built with. */
  items: string[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <ul class="stack" aria-label="Stack">
      {items.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  )
}

<style>
  /* Plain text, never pills: a Visitor can't click a Stack item, so it
     shouldn't look like something to click. The items run inline,
     separated by commas, which a layout that puts one item per line
     should hide along with the inline display. */
  .stack {
    margin: 0;
    padding: 0;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    list-style: none;
  }

  li {
    display: inline;
  }

  li + li::before {
    content: ", ";
  }
</style>
