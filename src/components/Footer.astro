---
import { feedPath } from "../lib/posts";
import { withBase } from "../lib/url";
import { siteConfig } from "../site.config";
import BlueskyIcon from "./icons/Bluesky.astro";
import EmailIcon from "./icons/Email.astro";
import GitHubIcon from "./icons/GitHub.astro";
import LinkedInIcon from "./icons/LinkedIn.astro";
import MastodonIcon from "./icons/Mastodon.astro";
import RssIcon from "./icons/Rss.astro";
import XIcon from "./icons/X.astro";

const { github, linkedin, mastodon, bluesky, x, email } = siteConfig.social;
const socialLinks = [
  { label: "GitHub", href: github, Icon: GitHubIcon },
  { label: "LinkedIn", href: linkedin, Icon: LinkedInIcon },
  { label: "Mastodon", href: mastodon, Icon: MastodonIcon },
  { label: "Bluesky", href: bluesky, Icon: BlueskyIcon },
  { label: "X", href: x, Icon: XIcon },
  { label: "Email", href: email && `mailto:${email}`, Icon: EmailIcon },
].filter((link) => link.href);
---

<footer class="site-footer">
  <ul class="social" aria-label="Elsewhere">
    {
      socialLinks.map(({ label, href, Icon }) => (
        <li>
          <a href={href} aria-label={label} rel="me">
            <Icon />
          </a>
        </li>
      ))
    }
    <li>
      <a href={withBase(feedPath)} aria-label="RSS feed">
        <RssIcon />
      </a>
    </li>
  </ul>
  <p>&copy; {new Date().getFullYear()} {siteConfig.name}</p>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    max-width: 48rem;
    width: 100%;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .social {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .social a {
    display: flex;
    padding: 0.5rem;
    color: var(--color-text-muted);
    font-size: 1.5rem;
  }

  .social a:hover {
    color: var(--color-text);
  }

  p {
    margin: 0;
  }
</style>
