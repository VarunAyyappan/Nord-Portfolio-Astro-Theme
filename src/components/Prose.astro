---
/** Styles rendered Markdown, which scoped styles can't otherwise reach. */
---

<div class="prose">
  <slot />
</div>

<style>
  .prose {
    font-size: 1.0625rem;
  }

  .prose > :global(:first-child) {
    margin-top: 0;
  }

  .prose :global(:is(h2, h3, h4)) {
    margin: 2em 0 0.5em;
    line-height: 1.3;
  }

  .prose :global(h2) {
    font-size: 1.5rem;
  }

  .prose :global(h3) {
    font-size: 1.25rem;
  }

  .prose :global(:is(p, ul, ol)) {
    margin: 0 0 1.25em;
  }

  .prose :global(li + li) {
    margin-top: 0.25em;
  }

  .prose :global(li::marker) {
    color: var(--color-text-muted);
  }
</style>
