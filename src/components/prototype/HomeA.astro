---
// PROTOTYPE (design directions): variant A, "Reading room". Words first:
// the tagline is the hero, set large in a serif, and every list is set as
// type rather than boxed into cards.
import { availability } from "../../lib/availability";
import { type Post, postPath } from "../../lib/posts";
import { type Project, projectPath } from "../../lib/projects";
import { sectionPaths } from "../../lib/sections";
import { withBase } from "../../lib/url";
import { siteConfig } from "../../site.config";

interface Props {
  projects: Project[];
  posts: Post[];
}

const { projects, posts } = Astro.props;
const day = new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "short" });
---

<div class="ra">
  <section class="ra-hero" aria-labelledby="hero-name">
    <h1 id="hero-name">{siteConfig.name}</h1>
    <p class="ra-tagline">{siteConfig.tagline}</p>
    <p class="ra-intro">{siteConfig.intro}</p>
    {
      availability && (
        <p class="ra-availability">
          <span
            class="ra-dot"
            style={`background-color: var(--color-availability-${availability.setting})`}
            aria-hidden="true"
          />
          {availability.label}
        </p>
      )
    }
    <p class="ra-actions">
      <a href={withBase(sectionPaths.projects)}>View Projects</a>
      <a href={withBase(sectionPaths.contact)}>Get in touch</a>
    </p>
  </section>

  {
    projects.length > 0 && (
      <section aria-labelledby="featured-heading">
        <h2 id="featured-heading">Featured Projects</h2>
        <ol class="ra-projects">
          {projects.map((project) => (
            <li>
              <h3>
                <a href={withBase(projectPath(project))}>{project.data.title}</a>
              </h3>
              <p class="ra-year">{project.data.date.getFullYear()}</p>
              <p class="ra-summary">{project.data.summary}</p>
              <p class="ra-stack">{project.data.stack.join(", ")}</p>
            </li>
          ))}
        </ol>
        <a class="ra-all" href={withBase(sectionPaths.projects)}>
          All Projects
        </a>
      </section>
    )
  }

  {
    posts.length > 0 && (
      <section aria-labelledby="latest-heading">
        <h2 id="latest-heading">Latest Posts</h2>
        <ol class="ra-posts">
          {posts.map((post) => (
            <li>
              <time datetime={post.data.date.toISOString()}>
                {day.format(post.data.date)}
              </time>
              <div>
                <h3>
                  <a href={withBase(postPath(post))}>{post.data.title}</a>
                </h3>
                <p>{post.data.description}</p>
              </div>
            </li>
          ))}
        </ol>
        <a class="ra-all" href={withBase(sectionPaths.blog)}>
          All Posts
        </a>
      </section>
    )
  }

  {
    siteConfig.skills.length > 0 && (
      <section aria-labelledby="skills-heading">
        <h2 id="skills-heading">Skills</h2>
        <dl class="ra-skills">
          {siteConfig.skills.map(({ heading, skills }) => (
            <div>
              <dt>{heading}</dt>
              <dd>{skills.join(", ")}</dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }
</div>

<style>
  .ra {
    max-width: 40rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  section {
    padding-bottom: 5rem;
  }

  .ra-hero {
    padding-top: clamp(3rem, 10vw, 7rem);
  }

  h1 {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .ra-tagline {
    margin: 1.25rem 0 0;
    font-size: clamp(2.25rem, 6.5vw, 3.75rem);
    font-weight: 350;
    line-height: 1.08;
    letter-spacing: -0.015em;
    font-variation-settings: "opsz" 72;
    text-wrap: balance;
  }

  .ra-intro {
    margin: 2rem 0 0;
    color: var(--color-text-muted);
    font-size: 1.25rem;
    line-height: 1.6;
  }

  .ra-availability {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin: 1.5rem 0 0;
    font-style: italic;
  }

  .ra-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
  }

  .ra-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    margin: 2rem 0 0;
    font-size: 1.25rem;
    font-weight: 500;
  }

  h2 {
    margin: 0 0 1.75rem;
    color: var(--color-text-muted);
    font-size: 1.125rem;
    font-style: italic;
    font-weight: 400;
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ra-projects li {
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: 1.5rem;
    margin-bottom: 2.25rem;
  }

  .ra-projects h3 {
    margin: 0;
    font-size: 1.75rem;
    font-weight: 500;
    line-height: 1.2;
    font-variation-settings: "opsz" 36;
  }

  .ra-projects h3 a,
  .ra-posts h3 a {
    text-decoration-color: transparent;
  }

  .ra-projects h3 a:hover,
  .ra-posts h3 a:hover {
    text-decoration-color: var(--color-accent);
  }

  .ra-year {
    margin: 0;
    padding-top: 0.5rem;
    color: var(--color-text-muted);
    font-variant-numeric: oldstyle-nums;
  }

  .ra-summary,
  .ra-stack {
    grid-column: 1 / -1;
    margin: 0.375rem 0 0;
  }

  .ra-summary {
    font-size: 1.125rem;
  }

  .ra-stack {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    font-style: italic;
  }

  .ra-posts li {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  .ra-posts time {
    padding-top: 0.3rem;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    font-variant-numeric: oldstyle-nums;
  }

  .ra-posts h3 {
    margin: 0;
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 1.25;
  }

  .ra-posts p {
    margin: 0.25rem 0 0;
    color: var(--color-text-muted);
  }

  .ra-all {
    font-size: 1.0625rem;
    font-weight: 500;
  }

  .ra-skills {
    margin: 0;
  }

  .ra-skills div {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: 1rem;
    margin-bottom: 0.75rem;
    font-size: 1.125rem;
  }

  .ra-skills dt {
    color: var(--color-text-muted);
    font-style: italic;
  }

  .ra-skills dd {
    margin: 0;
  }

  @media (width < 36em) {
    .ra-posts li,
    .ra-skills div {
      grid-template-columns: 1fr;
      gap: 0.125rem;
    }
  }
</style>
