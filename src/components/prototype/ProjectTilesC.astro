---
// PROTOTYPE (design directions): variant C's Project tiles, shared by Home
// and the Projects index so a Project looks the same on both. Two per row;
// the first spans both columns only when that keeps the rows even. A
// Project without a cover gets its title as a typographic cover.
import { Image } from "astro:assets";
import { formatMonth } from "../../lib/date";
import { type Project, projectPath } from "../../lib/projects";
import { withBase } from "../../lib/url";

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<ul class="ng-projects">
  {
    projects.map((project, i) => (
      <li class:list={{ wide: i === 0 && projects.length % 2 === 1 }}>
        <a href={withBase(projectPath(project))}>
          {project.data.cover ? (
            <Image
              src={project.data.cover}
              alt=""
              widths={[600, 1000, 1400]}
              sizes="(width < 60em) calc(100vw - 3rem), 48rem"
            />
          ) : (
            <span class="ng-plate">{project.data.title}</span>
          )}
          {project.data.cover && <span class="ng-title">{project.data.title}</span>}
        </a>
        <p class="ng-summary">{project.data.summary}</p>
        <p class="ng-meta">
          {formatMonth(project.data.date)}, {project.data.stack.join(", ")}
          {project.data.draft && <strong>, draft</strong>}
        </p>
      </li>
    ))
  }
</ul>

<style>
  .ng-projects {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .wide {
    grid-column: 1 / -1;
  }

  a {
    display: block;
    text-decoration: none;
  }

  img,
  .ng-plate {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
    background-color: var(--color-surface);
  }

  .ng-plate {
    display: flex;
    align-items: end;
    padding: 1.5rem;
    background-color: light-dark(var(--nord4), var(--nord1));
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.035em;
    text-wrap: balance;
    text-decoration: underline 0.1em transparent;
    text-underline-offset: 0.15em;
    transition: text-decoration-color var(--motion-duration) var(--motion-easing);
  }

  .ng-title {
    display: inline-block;
    margin-top: 1rem;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    text-decoration: underline 0.125em transparent;
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--motion-duration) var(--motion-easing);
  }

  a:hover :is(.ng-title, .ng-plate) {
    text-decoration-color: var(--color-accent);
  }

  .ng-summary {
    margin: 0.375rem 0 0;
    max-width: 36rem;
  }

  .ng-plate + .ng-summary,
  a:has(.ng-plate) + .ng-summary {
    margin-top: 1rem;
  }

  .ng-meta {
    margin: 0.375rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  @media (width < 60em) {
    .ng-projects {
      grid-template-columns: 1fr;
    }
  }
</style>
