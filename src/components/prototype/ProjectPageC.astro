---
// PROTOTYPE (design directions): variant C's Project page, mirroring its
// Post page. A huge title, the summary in the right column, the date, Stack
// and links as plain text in the left column, and the cover leading the
// right column above the write-up.
import { Image } from "astro:assets";
import { render } from "astro:content";
import { formatMonth } from "../../lib/date";
import type { Project } from "../../lib/projects";
import Prose from "../Prose.astro";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, summary, stack, repository, live, cover, date, draft } =
  project.data;
const { Content } = await render(project);
const links = [
  { label: "Repository", href: repository },
  { label: "Live site", href: live },
].filter((link) => link.href);
---

<article class="pc" aria-labelledby="project-title-c">
  <h1 id="project-title-c">{title}</h1>
  <p class="pc-summary">{summary}</p>
  <div class="pc-details">
    <p>
      <time datetime={date.toISOString()}>{formatMonth(date)}</time>
      {draft && <strong>, draft</strong>}
    </p>
    <h2>Stack</h2>
    <ul>
      {stack.map((item) => <li>{item}</li>)}
    </ul>
    {
      links.length > 0 && (
        <ul class="pc-links">
          {links.map(({ label, href }) => (
            <li>
              <a href={href}>{label}</a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
  <div class="pc-main">
    {
      cover && (
        <Image
          src={cover}
          alt=""
          widths={[800, 1200, 1600]}
          sizes="(width < 60em) calc(100vw - 3rem), 48rem"
          loading="eager"
        />
      )
    }
    <Prose>
      <Content />
    </Prose>
  </div>
</article>

<style>
  .pc {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 1.5rem;
    max-width: 78rem;
    margin: 0 auto;
    padding: clamp(2rem, 6vw, 4rem) 1.5rem 4rem;
  }

  h1 {
    grid-column: 1 / -1;
    max-width: 16ch;
    margin: 0;
    font-size: clamp(2.75rem, 7vw, 5.5rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.035em;
  }

  .pc-summary {
    grid-column: 5 / -1;
    margin: 1.5rem 0 3rem;
    color: var(--color-text-muted);
    font-size: 1.375rem;
  }

  .pc-details,
  .pc-main {
    padding-top: 1rem;
    border-top: 0.25rem solid var(--color-text);
  }

  .pc-details {
    grid-column: 1 / span 3;
    align-self: start;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
  }

  .pc-details p {
    margin: 0;
  }

  .pc-details h2 {
    margin: 1.5rem 0 0.25rem;
    color: var(--color-text);
    font-size: 0.9375rem;
    font-weight: 700;
  }

  .pc-details ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pc-links {
    margin-top: 1.5rem !important;
    padding-top: 1rem !important;
    border-top: 1px solid var(--color-border);
    font-weight: 700;
  }

  .pc-links li + li {
    margin-top: 0.375rem;
  }

  .pc-main {
    grid-column: 5 / -1;
    min-width: 0;
  }

  .pc-main img {
    display: block;
    width: 100%;
    height: auto;
    margin-bottom: 2.5rem;
  }

  .pc-main :global(.prose) {
    max-width: 44rem;
    font-size: 1.125rem;
  }

  @media (width < 60em) {
    .pc > * {
      grid-column: 1 / -1 !important;
    }

    .pc-summary {
      margin-bottom: 2rem;
    }

    .pc-details {
      margin-bottom: 2rem;
    }

    .pc-main {
      display: contents;
    }

    /* On a phone: title, summary, cover, details, then the write-up. */
    .pc-main img {
      grid-row: 3;
      grid-column: 1 / -1;
      margin-bottom: 2rem;
    }

    .pc-details {
      grid-row: 4;
    }

    .pc-main :global(.prose) {
      grid-column: 1 / -1;
      grid-row: 5;
    }
  }
</style>
