---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { SitePath } from "../lib/site-path";
import { absoluteUrl } from "../lib/url";
import { siteConfig } from "../site.config";

/** What a page tells link previews and search engines about itself. */
export interface Props {
  /** The page title, shown before the site name. Omit on Home. */
  title?: string;
  /** What the page is about. Defaults to the tagline in Site config. */
  description?: string;
  /**
   * The image link previews show: a cover, which is cropped to preview size,
   * or the site path of an image already that size, e.g. a Post's generated
   * share image. Defaults to the share image in Site config.
   */
  image?: ImageMetadata | SitePath;
  /** "article" for a Post, "website" for everything else. */
  type?: "website" | "article";
}

/** The size link previews show images at, and crop covers to. */
const shareImageSize = { width: 1200, height: 630 };

const {
  title,
  description = siteConfig.tagline,
  image,
  type = "website",
} = Astro.props;
const documentTitle = title ? `${title} | ${siteConfig.name}` : siteConfig.name;
const shareTitle = title ?? siteConfig.name;

// Link previews and search engines need absolute URLs. The 404 page is
// built as 404.html rather than in a folder, so its URL ends in .html.
const canonical =
  Astro.routePattern === "/404"
    ? absoluteUrl("/404.html", Astro.site)
    : new URL(Astro.url.pathname, Astro.site).href;
// A cover is cropped to link preview size, as a JPEG, since not every site
// that unfurls links reads WebP.
const shareImage =
  typeof image === "object"
    ? new URL(
        (
          await getImage({
            src: image,
            ...shareImageSize,
            fit: "cover",
            format: "jpg",
          })
        ).src,
        Astro.site,
      ).href
    : absoluteUrl(image ?? siteConfig.shareImage, Astro.site);
---

<title>{documentTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={shareTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={shareImage} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={shareTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={shareImage} />
