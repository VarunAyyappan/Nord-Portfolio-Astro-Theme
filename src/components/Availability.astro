---
/**
 * The Availability set in Site config, as its label after an Aurora dot. The
 * dot is decoration: the label alone carries the meaning, in text colors
 * that keep AA contrast in both Color modes. Renders nothing when unset.
 */
import { availability } from "../lib/availability";
---

{
  availability && (
    <p class="availability">
      <span
        class="dot"
        style={`background-color: var(--color-availability-${availability.setting})`}
        aria-hidden="true"
      />
      {availability.label}
    </p>
  )
}

<style>
  /* Just the dot and the label, with no pill around them. */
  .availability {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 1rem 0 0;
    font-weight: 600;
  }

  .dot {
    flex: none;
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
  }
</style>
