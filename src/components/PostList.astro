---
import { type Post, postPath } from "../lib/posts";
import { withBase } from "../lib/url";
import PostMeta from "./PostMeta.astro";
import Tags from "./Tags.astro";

interface Props {
  posts: Post[];
  /** The heading level of each Post's title, so the list fits the page outline. */
  headingLevel?: 2 | 3;
}

const { posts, headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as const;
---

<ul class="post-list">
  {
    posts.map((post) => (
      <li>
        <article>
          <Heading class="title">
            <a href={withBase(postPath(post))}>{post.data.title}</a>
          </Heading>
          <PostMeta post={post} />
          <p class="description">{post.data.description}</p>
          <Tags tags={post.data.tags} />
        </article>
      </li>
    ))
  }
</ul>

<style>
  .post-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  article {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .title {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .title a {
    text-decoration-color: transparent;
  }

  .title a:hover {
    text-decoration-color: var(--color-accent);
  }

  .description {
    margin: 0;
    color: var(--color-text-muted);
  }
</style>
