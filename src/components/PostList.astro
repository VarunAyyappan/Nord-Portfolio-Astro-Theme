---
import { formatDay } from "../lib/date";
import { type Post, postPath } from "../lib/posts";
import { withBase } from "../lib/url";

interface Props {
  posts: Post[];
  /** The heading level of each Post's title, so the list fits the page outline. */
  headingLevel?: 2 | 3;
}

const { posts, headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as const;
---

<ul class="post-list">
  {
    posts.map((post) => (
      <li>
        <article>
          <Heading class="title">
            <a href={withBase(postPath(post))}>{post.data.title}</a>
          </Heading>
          <p class="meta">
            <time datetime={post.data.date.toISOString()}>
              {formatDay(post.data.date)}
            </time>
            {post.data.draft && <span class="draft">Draft</span>}
          </p>
          <p class="description">{post.data.description}</p>
        </article>
      </li>
    ))
  }
</ul>

<style>
  .post-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  article {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .title {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .title a {
    text-decoration-line: none;
  }

  .title a:hover {
    text-decoration-line: underline;
  }

  .meta {
    display: flex;
    gap: 0.75rem;
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .draft {
    font-weight: 700;
    text-transform: uppercase;
  }

  .description {
    margin: 0;
    color: var(--color-text-muted);
  }
</style>
