---
/**
 * The page layout Posts and Projects share, on the page grid's 12 columns
 * (see global.css). The title spans the full width, and the summary sits in
 * the right 8 columns under it. Below them, each under a thick rule, the
 * details fill the left 3 columns and the text the right 8, led by the
 * cover when there is one.
 *
 * The `details` slot holds the dates and the like, and the `links` slot
 * holds links (a Project's Repository and Live site, a Post's Tags), which
 * go below a thin rule, one per line. The default slot is the rendered
 * Markdown.
 *
 * On a phone, the page stacks as title, summary, cover, details, then text.
 */

import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Prose from "./Prose.astro";

interface Props {
  title: string;
  /** The id of the title, which names the page's article. */
  titleId: string;
  /** A Project's summary or a Post's description. */
  summary: string;
  /** Decoration only, so it gets an empty `alt`. */
  cover?: ImageMetadata;
}

const { title, titleId, summary, cover } = Astro.props;
---

<article class="page-grid detail-page" aria-labelledby={titleId}>
  <header>
    <h1 class="page-heading" id={titleId}>{title}</h1>
    <p class="summary">{summary}</p>
  </header>
  <div class="details">
    <slot name="details" />
    {
      Astro.slots.has("links") && (
        <div class="links">
          <slot name="links" />
        </div>
      )
    }
  </div>
  <div class="text">
    {
      // sizes follows the text column: the full width less the page
      // grid's gutters on a phone, and 8 of the grid's 12 columns from
      // 60em, which stop growing with the grid at 78rem. It's worked out
      // from --grid-width, --grid-gutter and --grid-gap in global.css, so
      // change it with them.
      cover && (
        <Image
          src={cover}
          alt=""
          widths={[800, 1600]}
          sizes="(width < 60em) calc(100vw - 3rem), (width < 78rem) calc(66.67vw - 2.5rem), 49.5rem"
          loading="eager"
        />
      )
    }
    <div class="body">
      <Prose>
        <slot />
      </Prose>
    </div>
  </div>
</article>

<style>
  /* The header shares the page grid's columns, so the summary can sit in
     the right 8 under a title that spans all 12. */
  header {
    display: grid;
    grid-template-columns: subgrid;
    row-gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .page-heading,
  .summary {
    grid-column: 1 / -1;
  }

  /* The largest type on the site, wrapping at about 16 characters. */
  .page-heading {
    max-width: 16ch;
    font-size: clamp(2.75rem, 7vw, 5.5rem);
  }

  .summary {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 1.375rem;
    line-height: 1.4;
  }

  .details,
  .text {
    padding-top: 1rem;
    border-top: var(--rule-thick);
  }

  .details {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 2rem;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
  }

  /* One detail per line: a Post's dates and reading time, say. */
  .details :global(.meta) {
    flex-direction: column;
    gap: 0.25rem;
  }

  .links {
    padding-top: 1rem;
    border-top: var(--rule-thin);
  }

  .links :global(ul) {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* At least 24px tall, the WCAG 2.2 AA minimum for a target. */
  .links :global(a) {
    display: inline-block;
    line-height: 1.5rem;
    font-weight: 700;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    margin-bottom: 2.5rem;
  }

  /* A readable measure for the text, a little narrower than the cover. */
  .body {
    max-width: 44rem;
    font-size: 1.125rem;
  }

  .body :global(.prose) {
    font-size: inherit;
  }

  @media (width >= 60em) {
    header {
      margin-bottom: 3rem;
    }

    .summary {
      grid-column: 5 / -1;
    }

    .details {
      grid-column: 1 / span 3;
      grid-row: 2;
      align-self: start;
      margin-bottom: 0;
    }

    .text {
      grid-column: 5 / -1;
      grid-row: 2;
    }
  }

  /* On a phone the text column lets its cover and text be placed apart,
     so the cover can come before the details. They become the page grid's
     own children then, so they must span its 12 columns themselves. */
  @media (width < 60em) {
    .text {
      display: contents;
    }

    img,
    .body {
      grid-column: 1 / -1;
    }

    header {
      order: 1;
    }

    img {
      order: 2;
      margin-bottom: 2rem;
    }

    .details {
      order: 3;
    }

    .body {
      order: 4;
      padding-top: 1rem;
      border-top: var(--rule-thick);
    }
  }
</style>
