---
import { formatMonth } from "../lib/date";
import type { Project } from "../lib/projects";
import DraftBadge from "./DraftBadge.astro";
import MetaLine from "./MetaLine.astro";

interface Props {
  project: Project;
}

const { date, draft } = Astro.props.project.data;
---

<MetaLine>
  <time datetime={date.toISOString()}>{formatMonth(date)}</time>
  {draft && <DraftBadge />}
</MetaLine>
