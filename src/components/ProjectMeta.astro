---
import { formatMonth } from "../lib/date";
import type { Project } from "../lib/projects";
import DraftMarker from "./DraftMarker.astro";
import MetaLine from "./MetaLine.astro";

interface Props {
  project: Project;
}

const { date, draft } = Astro.props.project.data;
---

<MetaLine>
  <span><time datetime={date.toISOString()}>{formatMonth(date)}</time>{draft && <DraftMarker />}</span>
</MetaLine>
