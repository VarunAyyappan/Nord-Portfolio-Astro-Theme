---
import { formatMonth } from "../lib/date";
import type { Project } from "../lib/projects";
import MetaDate from "./MetaDate.astro";
import MetaLine from "./MetaLine.astro";

interface Props {
  project: Project;
}

const { date, draft } = Astro.props.project.data;
---

<MetaLine>
  <MetaDate date={date} text={formatMonth(date)} draft={draft} />
</MetaLine>
