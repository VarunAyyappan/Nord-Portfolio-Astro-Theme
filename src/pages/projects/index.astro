---
import PageGrid from "../../components/PageGrid.astro";
import ProjectTiles from "../../components/ProjectTiles.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getProjects } from "../../lib/projects";

const projects = await getProjects();
---

<BaseLayout title="Projects">
  <PageGrid as="section" aria-labelledby="projects-heading">
    <h1 slot="heading" class="page-heading" id="projects-heading">Projects</h1>
    <ProjectTiles projects={projects} />
  </PageGrid>
</BaseLayout>
