---
import { render } from "astro:content";
import Prose from "../../components/Prose.astro";
import Tags from "../../components/Tags.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDay } from "../../lib/date";
import { getPosts, type Post, readingMinutes } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, date, updated, tags, draft } = post.data;
const { Content } = await render(post);
---

<BaseLayout {title} {description} type="article">
  <article class="post" aria-labelledby="post-title">
    <header>
      <h1 id="post-title">{title}</h1>
      <p class="description">{description}</p>
      <p class="meta">
        <time datetime={date.toISOString()}>{formatDay(date)}</time>
        {
          updated && (
            <span>
              Updated{" "}
              <time datetime={updated.toISOString()}>{formatDay(updated)}</time>
            </span>
          )
        }
        <span>{readingMinutes(post)} min read</span>
        {draft && <span class="draft">Draft</span>}
      </p>
      <Tags tags={tags} />
    </header>
    <Prose>
      <Content />
    </Prose>
  </article>
</BaseLayout>

<style>
  .post {
    max-width: 48rem;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 6vw, 3rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .description {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 1.25rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .draft {
    font-weight: 700;
    text-transform: uppercase;
  }
</style>
