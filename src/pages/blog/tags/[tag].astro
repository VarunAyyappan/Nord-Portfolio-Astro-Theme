---
import PostList from "../../../components/PostList.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getTags, type Tag } from "../../../lib/posts";

export async function getStaticPaths() {
  const tags = await getTags();
  return tags.map((tag) => ({
    params: { tag: tag.slug },
    props: { tag },
  }));
}

interface Props {
  tag: Tag;
}

const { tag } = Astro.props;
const heading = `Posts tagged ${tag.name}`;
---

<BaseLayout title={heading}>
  <section class="page" aria-labelledby="tag-heading">
    <h1 class="page-heading" id="tag-heading">{heading}</h1>
    <PostList posts={tag.posts} />
  </section>
</BaseLayout>

<style>
  .page-heading {
    margin-bottom: 2rem;
  }
</style>
