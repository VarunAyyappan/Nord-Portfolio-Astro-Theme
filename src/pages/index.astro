---
import Availability from "../components/Availability.astro";
import PostList from "../components/PostList.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLatestPosts } from "../lib/posts";
import { getFeaturedProjects } from "../lib/projects";
import { withBase } from "../lib/url";
import { siteConfig } from "../site.config";

const featuredProjects = await getFeaturedProjects();
const latestPosts = await getLatestPosts();
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-name">
    <h1 id="hero-name">{siteConfig.name}</h1>
    <p class="tagline">{siteConfig.tagline}</p>
    <Availability />
    <p class="intro">{siteConfig.intro}</p>
    <ul class="actions">
      <li>
        <a class="button primary" href={withBase("/projects/")}>
          View Projects
        </a>
      </li>
      <li>
        <a class="button" href={withBase("/contact/")}>Get in touch</a>
      </li>
    </ul>
  </section>
  {
    featuredProjects.length > 0 && (
      <section class="featured" aria-labelledby="featured-heading">
        <h2 id="featured-heading">Featured Projects</h2>
        <ProjectGrid projects={featuredProjects} headingLevel={3} />
        <a class="all" href={withBase("/projects/")}>
          All Projects
        </a>
      </section>
    )
  }
  {
    latestPosts.length > 0 && (
      <section class="latest" aria-labelledby="latest-heading">
        <h2 id="latest-heading">Latest Posts</h2>
        <PostList posts={latestPosts} headingLevel={3} />
        <a class="all" href={withBase("/blog/")}>
          All Posts
        </a>
      </section>
    )
  }
  {
    siteConfig.skills.length > 0 && (
      <section class="skills" aria-labelledby="skills-heading">
        <h2 id="skills-heading">Skills</h2>
        <div class="skill-groups">
          {siteConfig.skills.map(({ heading, skills }) => (
            <div>
              <h3>{heading}</h3>
              <ul>
                {skills.map((skill) => (
                  <li>{skill}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .hero,
  .featured,
  .latest,
  .skills {
    max-width: 48rem;
    margin: 0 auto;
    padding: clamp(3rem, 12vw, 8rem) 1.5rem;
  }

  .featured,
  .latest,
  .skills {
    padding-top: 0;
  }

  h2 {
    margin: 0 0 1.5rem;
    font-size: 1.75rem;
    line-height: 1.2;
  }

  .all {
    display: inline-block;
    margin-top: 1.5rem;
    font-weight: 600;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 8vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  h1::after {
    content: "";
    display: block;
    width: 4rem;
    height: 0.25rem;
    margin-top: 1rem;
    border-radius: 0.125rem;
    background-color: var(--color-accent);
  }

  .skill-groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1.5rem;
  }

  h3 {
    margin: 0 0 0.75rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .skill-groups ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .skill-groups li {
    padding: 0.25rem 0.75rem;
    border-left: 0.1875rem solid var(--color-accent);
    border-radius: 0.25rem;
    background-color: var(--color-surface);
    font-size: 0.9375rem;
  }

  .tagline {
    margin: 1.5rem 0 0;
    font-size: clamp(1.25rem, 3vw, 1.5rem);
    font-weight: 600;
  }

  .intro {
    margin: 1rem 0 0;
    color: var(--color-text-muted);
    font-size: 1.125rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .button {
    display: inline-block;
    padding: 0.625rem 1.25rem;
    border: 0.125rem solid var(--color-accent);
    border-radius: 0.375rem;
    font-weight: 600;
    text-decoration-line: none;
  }

  .button:hover {
    background-color: var(--color-surface);
  }

  /* Text and background colors swapped, which keeps the button at AA
     contrast in both Color modes. */
  .button.primary {
    border-color: var(--color-text);
    background-color: var(--color-text);
    color: var(--color-background);
  }

  .button.primary:hover {
    border-color: var(--color-text-muted);
    background-color: var(--color-text-muted);
  }
</style>
