---
import Entry from "../components/Entry.astro";
import PageGrid from "../components/PageGrid.astro";
import Stack from "../components/Stack.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getEducation, getExperience } from "../lib/experience";
import { isSitePath } from "../lib/site-path";
import { withBase } from "../lib/url";
import { siteConfig } from "../site.config";

const experience = await getExperience();
const education = await getEducation();

// A full URL is used as given, and opens like any other link: browsers
// ignore `download` for a file on another site.
const { resume } = siteConfig;
const resumeLink = !resume
  ? undefined
  : isSitePath(resume)
    ? { href: withBase(resume), download: true }
    : { href: resume };
---

<BaseLayout title="Experience">
  <PageGrid>
    <h1 class="page-heading" slot="heading">Experience</h1>
    {
      resumeLink && (
        <a class="resume" {...resumeLink}>
          Download résumé (PDF)
        </a>
      )
    }
    {
      experience.length > 0 && (
        <section aria-labelledby="roles-heading">
          <h2 class="section-heading" id="roles-heading">Roles</h2>
          <ol class="entries">
            {experience.map(({ data }) => (
              <li>
                <Entry
                  title={data.role}
                  subtitle={data.organization}
                  meta={{ start: data.start, end: data.end, location: data.location }}
                >
                  <ul class="highlights">
                    {data.highlights.map((highlight) => (
                      <li>{highlight}</li>
                    ))}
                  </ul>
                  <Stack items={data.stack} />
                </Entry>
              </li>
            ))}
          </ol>
        </section>
      )
    }
    {
      education.length > 0 && (
        <section aria-labelledby="education-heading">
          <h2 class="section-heading" id="education-heading">Education</h2>
          <ol class="entries">
            {education.map(({ data }) => (
              <li>
                <Entry
                  title={data.qualification}
                  subtitle={data.institution}
                  meta={{ start: data.start, end: data.end, location: data.location }}
                />
              </li>
            ))}
          </ol>
        </section>
      )
    }
  </PageGrid>
</BaseLayout>

<style>
  .resume {
    display: inline-block;
    font-weight: 600;
  }

  /* A timeline: a rule down the left, with an accent dot at each entry. */
  .entries {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin: 0;
    padding: 0 0 0 1.5rem;
    border-left: 0.125rem solid var(--color-border);
    list-style: none;
  }

  .entries > li {
    position: relative;
  }

  .entries > li::before {
    content: "";
    position: absolute;
    top: 0.5rem;
    left: calc(-1.5rem - 0.375rem - 0.0625rem);
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background-color: var(--color-accent);
  }

  .highlights {
    margin: 0.5rem 0;
    padding-left: 1.25rem;
    list-style: disc;
  }
</style>
